<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P06" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P06">
    <bpmn:participant id="Part_P06" name="P06 — Fiscalização técnica de campo (programada e por demanda) (AS-IS · 1 casos · estudo de caso)" processRef="Processo_P06" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P06" isExecutable="false">
    <bpmn:documentation>Da programação das vistorias anuais às unidades operacionais da concessionária à ciência do parecer jurídico e ao sobrestamento do processo Fontes: Estudo de caso SEI-480002/001314/2024 (Câmara de Saneamento, concessão do Bloco 1), com os processos de fiscalização anexados; fichas de trabalho das peças e resumos de leitura integral dos documentos.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P06">
      <bpmn:lane id="Lane_CASAN" name="Câmara Técnica de Saneamento (CASAN)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Vistorias anuais determinadas por deliberação">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="j1" name="">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t1" name="Convocar concessionária para vistoria conjunta&#10;[100% de 1 casos · espera 8,5 du · 1,6 h]">
      <bpmn:documentation>freq: 100% de 1; du: 8,5; horas: 1,6 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Vistoriar unidade e elaborar relatório&#10;[100% de 1 casos · espera 10,5 du · 24,5 h]">
      <bpmn:documentation>freq: 100% de 1; du: 10,5; horas: 24,5 h; status: perda; nota: Perda: pedido complementacao (100%), prazo concedido (100%)</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Encaminhar relatórios à concessionária com prazo&#10;[100% de 1 casos · espera 6 du · 0,8 h]">
      <bpmn:documentation>freq: 100% de 1; du: 6; horas: 0,8 h; status: perda; nota: Perda: diligencia externa (100%), prazo concedido (100%)</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e1" name="Prazo de manifestação da concessionária decorrido">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g1" name="Há outras unidades a vistoriar?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Consolidar análise técnica das fiscalizações&#10;[100% de 1 casos · espera 106 du · 12,2 h]">
      <bpmn:documentation>freq: 100% de 1; du: 106; horas: 12,2 h; status: espera; nota: Espera mediana 106 du (q3 106); Perda: pedido complementacao (100%)</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Dar ciência do parecer à concessionária&#10;[100% de 1 casos · espera 55 du · 0,8 h]">
      <bpmn:documentation>freq: 100% de 1; du: 55; horas: 0,8 h; status: espera; nota: Espera mediana 55 du (q3 55)</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e2" name="Manifestação da concessionária recebida">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t6" name="Rebater manifestação da concessionária&#10;[100% de 1 casos · espera 2 du · 8 h]">
      <bpmn:documentation>freq: 100% de 1; du: 2; horas: 8 h; status: perda; nota: Perda: reiteracao (100%)</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Emitir parecer jurídico sobre a fiscalização&#10;[100% de 1 casos · espera 205 du · 10 h]">
      <bpmn:documentation>freq: 100% de 1; du: 205; horas: 10 h; status: espera; nota: Espera mediana 205 du (q3 205); Perda: reiteracao (100%)</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Oficiar concessionária e sobrestar processo&#10;[100% de 1 casos · espera 0 du · 0,8 h]">
      <bpmn:documentation>freq: 100% de 1; du: 0; horas: 0,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f1" name="Processo sobrestado">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s1" targetRef="j1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1" sourceRef="j1" targetRef="t1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2" sourceRef="t1" targetRef="t2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F3" sourceRef="t2" targetRef="t3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="t3" targetRef="e1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="e1" targetRef="g1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" name="Não" sourceRef="g1" targetRef="t4"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" name="Sim" sourceRef="g1" targetRef="j1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="t4" targetRef="t5"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="t5" targetRef="e2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" sourceRef="e2" targetRef="t6"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="t6" targetRef="t7"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" sourceRef="t7" targetRef="t8"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="t8" targetRef="f1"></bpmn:sequenceFlow>
    <bpmn:textAnnotation id="Nota_0"><bpmn:text>Perda: pedido complementacao (100%), prazo concedido (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_0" sourceRef="t2" targetRef="Nota_0" />
    <bpmn:textAnnotation id="Nota_1"><bpmn:text>Perda: diligencia externa (100%), prazo concedido (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="t3" targetRef="Nota_1" />
    <bpmn:textAnnotation id="Nota_2"><bpmn:text>Espera mediana 106 du (q3 106); Perda: pedido complementacao (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_2" sourceRef="t4" targetRef="Nota_2" />
    <bpmn:textAnnotation id="Nota_3"><bpmn:text>Espera mediana 55 du (q3 55)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_3" sourceRef="t5" targetRef="Nota_3" />
    <bpmn:textAnnotation id="Nota_4"><bpmn:text>Perda: reiteracao (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_4" sourceRef="t6" targetRef="Nota_4" />
    <bpmn:textAnnotation id="Nota_5"><bpmn:text>Espera mediana 205 du (q3 205); Perda: reiteracao (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_5" sourceRef="t7" targetRef="Nota_5" />
  </bpmn:process>
